# Employee Monitoring Dashboard - NGINX + Blazor WASM
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY ["src/Dashboard/EmployeeMonitoring.Dashboard.csproj", "src/Dashboard/"]
COPY ["src/Contracts/EmployeeMonitoring.Contracts.csproj", "src/Contracts/"]
COPY ["EmployeeMonitoring.sln", "."]

RUN dotnet restore "EmployeeMonitoring.sln"

COPY . .

RUN dotnet publish "src/Dashboard/EmployeeMonitoring.Dashboard.csproj" -c Release -o /app/publish

FROM nginx:alpine AS final
WORKDIR /usr/share/nginx/html

COPY --from=build /app/publish/wwwroot/ .
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]