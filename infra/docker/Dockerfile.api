# Employee Monitoring API - Linux Container
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

# Install tools for debugging
RUN apt-get update && apt-get install -y curl netcat-openbsd && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r appgroup && useradd -r -g appgroup appuser
USER appuser

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy project files
COPY ["src/Api/EmployeeMonitoring.Api.csproj", "src/Api/"]
COPY ["src/Contracts/EmployeeMonitoring.Contracts.csproj", "src/Contracts/"]
COPY ["src/Common/EmployeeMonitoring.Common.csproj", "src/Common/"]
COPY ["EmployeeMonitoring.sln", "."]

# Restore dependencies
RUN dotnet restore "EmployeeMonitoring.sln"

# Copy source
COPY . .

# Build API
RUN dotnet publish "src/Api/EmployeeMonitoring.Api.csproj" -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "EmployeeMonitoring.Api.dll"]