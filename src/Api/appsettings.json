{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Grpc": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=employeemonitoring;Username=postgres;Password=postgres",
    "AuditConnection": "Host=localhost;Database=employeemonitoring_audit;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "EmployeeMonitoring.Api",
    "Audience": "EmployeeMonitoring.Client",
    "SigningKey": "your-256-bit-secret-key-here-minimum-32-chars",
    "ExpiryMinutes": 60
  },
  "OpenIdConnect": {
    "Authority": "https://login.microsoftonline.com/{tenant-id}/v2.0",
    "ClientId": "your-client-id",
    "ClientSecret": "your-client-secret",
    "CallbackPath": "/signin-oidc",
    "Scopes": [ "openid", "profile", "email", "offline_access" ]
  },
  "SignalR": {
    "HubPath": "/hubs/agent",
    "AdminHubPath": "/hubs/admin"
  },
  "Grpc": {
    "Port": 5001,
    "EnableHttp2": true
  },
  "Agent": {
    "DefaultScreenshotIntervalSeconds": 600,
    "DefaultActivityIntervalSeconds": 60,
    "MaxBatchSize": 100,
    "HeartbeatTimeoutSeconds": 120
  },
  "Retention": {
    "ScreenshotsDays": 30,
    "ActivityDays": 90,
    "DlpEventsDays": 365,
    "AuditLogsDays": 2555
  },
  "Storage": {
    "ScreenshotsPath": "/data/screenshots",
    "TempPath": "/tmp/employeemonitoring"
  },
  "Notifications": {
    "Email": {
      "SmtpHost": "smtp.office365.com",
      "SmtpPort": 587,
      "Username": "alerts@company.com",
      "Password": "password",
      "FromAddress": "alerts@company.com"
    },
    "Teams": {
      "WebhookUrl": "https://outlook.office.com/webhook/..."
    },
    "Slack": {
      "WebhookUrl": "https://hooks.slack.com/services/..."
    }
  },
  "Features": {
    "EnableRealTimeUpdates": true,
    "EnableScreenshotBlur": true,
    "EnablePauseNotifications": true,
    "EnableDlpMonitoring": true
  }
}