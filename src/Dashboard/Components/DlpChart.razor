@using MudBlazor

<MudCard Class="h-100">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="text-warning">DLP Monitoring</MudText>
        <MudDivider />
        @if (Data.Count > 0)
        {
            <MudText>Total DLP Events: @Data.Values.Sum()</MudText>
            <MudText>Critical: @Data.Count(kvp => kvp.Value >= 80)</MudText>
        }
        else
        {
            <MudText>No DLP events recorded</MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public Dictionary<string, int> Data { get; set; } = new();
}