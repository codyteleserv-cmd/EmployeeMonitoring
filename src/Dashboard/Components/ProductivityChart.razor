@using ChartJs.Blazor
@using ChartJs.Blazor.Charts
@using ChartJs.Blazor.ChartJS.Common.Enums
@using ChartJs.Blazor.ChartJS.Common.Axes
@using ChartJs.Blazor.ChartJS.Common.Properties

<MudCard Class="h-100">
    <MudCardContent>
        <ChartJsLineChart @ref="_chart" Config="@_config" />
    </MudCardContent>
</MudCard>

@code {
    private ChartJsLineChart? _chart;
    private LineConfig _config = new();

    [Parameter] public List<ProductivityDataPoint> Data { get; set; } = new();

    protected override void OnParametersSet()
    {
        _config = new LineConfig
        {
            Options = new LineOptions
            {
                Responsive = true,
                MaintainAspectRatio = false,
                Interaction = new Interaction { Mode = InteractionMode.Index, Intersect = false },
                Plugins = new Plugins
                {
                    Legend = new Legend { Display = true, Position = Position.Top }
                },
                Scales = new Scales
                {
                    X = new CartesianAxis
                    {
                        Type = AxisType.Time,
                        Time = new TimeScale
                        {
                            Unit = TimeUnit.Hour,
                            DisplayFormats = new TimeDisplayFormats { Hour = "HH:mm" },
                            TooltipFormat = "HH:mm"
                        },
                        Title = new AxisTitle { Display = true, Text = "Time" }
                    },
                    Y = new CartesianAxis
                    {
                        Min = 0,
                        Max = 100,
                        Title = new AxisTitle { Display = true, Text = "Productivity %" },
                        Ticks = new CartesianLinearTick { StepSize = 20 }
                    }
                }
            }
        };

        _config.Data.Labels = Data.Select(d => d.Timestamp.ToString("HH:mm")).ToArray();
        
        var dataset = new LineDataset<double?>
        {
            Label = "Productivity %",
            Data = Data.Select(d => d.Productivity).Cast<double?>().ToList(),
            BorderColor = "rgba(25, 118, 210, 1)",
            BackgroundColor = "rgba(25, 118, 210, 0.1)",
            Fill = true,
            Tension = 0.3,
            PointRadius = 3,
            PointHoverRadius = 5
        };

        _config.Data.Datasets.Add(dataset);
    }
}

public class ProductivityDataPoint
{
    public DateTimeOffset Timestamp { get; set; }
    public double Productivity { get; set; }
}