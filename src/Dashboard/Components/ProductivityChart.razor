@using MudBlazor

<MudCard Class="h-100">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="text-primary">Productivity Overview</MudText>
        <MudDivider />
        @if (Data.Count > 0)
        {
            <MudText>Average: @((int)Math.Round(Data.Average()))% Productivity</MudText>
            <MudText>Total Checks: @Data.Count</MudText>
        }
        else
        {
            <MudText>No productivity data available</MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public List<double> Data { get; set; } = new();
}