@page "/screenshots"
<PageTitle>Screenshots</PageTitle>

@using EmployeeMonitoring.Dashboard.Models
@using EmployeeMonitoring.Dashboard.Services
@using MudBlazor

<MudGrid Class="mt-4">
    <MudItem xs="12">
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h6">Screenshots</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudText>Screenshot monitoring feature coming in next release.</MudText>
                <MudProgressLinear Indeterminate="true" Class="mt-3" />
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    [Inject] ApiService ApiService { get; set; } = default!;
    [Inject] EmployeeMonitoring.Dashboard.Services.AgentStateService AgentState { get; set; } = default!;

    private List<ScreenshotViewModel> _screenshots = new();
    private ScreenshotViewModel? _selectedScreenshot;
}