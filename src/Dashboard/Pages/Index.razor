@page "/"
@using EmployeeMonitoring.Dashboard.Models
@using EmployeeMonitoring.Dashboard.Services
@using EmployeeMonitoring.Contracts
@using MudBlazor
<PageTitle>Dashboard</PageTitle>

<MudGrid Class="mt-4">
    <!-- Stats Cards -->
    <MudItem xs="12" sm="6" md="3">
        <StatCard Title="Total Agents" Value="0" Icon="@MudBlazor.Icons.Material.Filled.Computer" Color="MudBlazor.Severity.Primary" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Title="Online" Value="0" Icon="@MudBlazor.Icons.Material.Filled.CheckCircle" Color="MudBlazor.Severity.Success" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Title="Paused" Value="0" Icon="@MudBlazor.Icons.Material.Filled.PauseCircle" Color="MudBlazor.Severity.Warning" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Title="Offline" Value="0" Icon="@MudBlazor.Icons.Material.Filled.OfflinePin" Color="MudBlazor.Severity.Error" />
    </MudItem>

    <!-- DLP Stats -->
    <MudItem xs="12" sm="6" md="3">
        <StatCard Title="DLP Events (24h)" Value="0" Icon="@MudBlazor.Icons.Material.Filled.Security" Color="MudBlazor.Severity.Error" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Title="Unacknowledged" Value="0" Icon="@MudBlazor.Icons.Material.Filled.Warning" Color="MudBlazor.Severity.Warning" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Title="Avg Productivity" Value="0%" Icon="@MudBlazor.Icons.Material.Filled.TrendingUp" Color="MudBlazor.Severity.Info" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Title="Pause Time Today" Value="0 min" Icon="@MudBlazor.Icons.Material.Filled.Timer" Color="MudBlazor.Severity.Secondary" Unit="min" />
    </MudItem>
</MudGrid>

@code {
    private MudBlazor.Severity GetStatusColor(string status) => status switch
    {
        "Online" => MudBlazor.Severity.Success,
        "Paused" => MudBlazor.Severity.Warning,
        "Offline" => MudBlazor.Severity.Error,
        _ => MudBlazor.Severity.Info
    };

    private MudBlazor.Severity GetHealthColor(string health) => health switch
    {
        "Healthy" => MudBlazor.Severity.Success,
        "Degraded" => MudBlazor.Severity.Warning,
        "Unhealthy" => MudBlazor.Severity.Error,
        _ => MudBlazor.Severity.Info
    };
}