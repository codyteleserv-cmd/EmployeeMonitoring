@inherits LayoutComponentBase
@using EmployeeMonitoring.Dashboard.Services
@using EmployeeMonitoring.Dashboard.Models
@using EmployeeMonitoring.Contracts
@inject ApiService Api
@inject NavigationManager Nav
@inject AdminHubService HubService
@inject AgentStateService AgentStateService
@inject NotificationService Notify
@using MudBlazor

<MudLayout>
    <MudAppBar Elevation="1" Class="shadow-sm">
        <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.Menu" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudSpacer />
        <MudText Typo="Typo.h6" Class="mx-auto">Employee Monitoring Dashboard</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mx-auto">Employee Monitoring</MudText>
        <MudIconButton Icon="@MudBlazor.Icons.Material.Filled.Logout" OnClick="@Logout" />
    </MudAppBar>

    <MudDrawer ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pt-16">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void Logout()
    {
        Nav.NavigateTo("/login", forceLoad: true);
    }

    protected override async Task OnInitializedAsync()
    {
        await HubService.InitializeAsync();
        await AgentStateService.InitializeAsync();
    }
}
}